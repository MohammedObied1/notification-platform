APP_NAME="Notification Platform API"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SQLite for local dev, PostgreSQL in production/docker (real row-level locking needs Postgres)
DATABASE_URL=sqlite:///./notifications.db
# DATABASE_URL=postgresql+psycopg2://notif:notif@db:5432/notif

# Required for rate limiting, pub/sub for live dashboard updates
REDIS_URL=redis://redis:6379/0

# RabbitMQ connection. Management UI (dev): http://localhost:15672 (guest/guest)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Worker tuning
NOTIFICATION_WORKER_PREFETCH=10
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_MAX_ATTEMPTS=5
